# Copy to .env and adjust. All variables are optional.

# Sandbox/demo mode (§16): 1 = scripted fake agents on a fake budget —
# full UI, zero spend. 0 (or unset) = real Claude Code sessions.
AGENT_QUEST_DEMO=0

# Player budget in USD (the hearts, §2). Real spend stops at this ceiling.
AGENT_QUEST_BUDGET_USD=5

# Hard cap on concurrently running agents (§8/§12).
AGENT_QUEST_MAX_AGENTS=8

# Control server WebSocket port.
AGENT_QUEST_PORT=8787

# API key for the Claude Agent SDK. If unset, the SDK falls back to this
# machine's existing Claude Code credentials.
# ANTHROPIC_API_KEY=sk-ant-...
